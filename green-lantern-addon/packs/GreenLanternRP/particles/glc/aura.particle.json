{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.radius",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.9)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 0.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 + 0.05 * (1 - variable.particle_age / variable.particle_lifetime)",
          "0.07 + 0.05 * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "(1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
