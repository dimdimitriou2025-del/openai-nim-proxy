{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:explosion",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 34
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.8)"
      },
      "minecraft:particle_initial_speed": "math.random(4, 11) * variable.radius * 0.5",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -2,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.25 + variable.particle_random_3 * 0.3) * (1 - variable.particle_age / variable.particle_lifetime) + 0.05",
          "(0.25 + variable.particle_random_3 * 0.3) * (1 - variable.particle_age / variable.particle_lifetime) + 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.3)",
          "math.min(1, variable.color.g * 1.3)",
          "math.min(1, variable.color.b * 1.3)",
          "(1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
