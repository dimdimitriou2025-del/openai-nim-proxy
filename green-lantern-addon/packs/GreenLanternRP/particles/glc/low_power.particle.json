      "minecraft:emitter_shape_sphere": {
        "radius": 0.25,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.6)"
      },
      "minecraft:particle_initial_speed": 1.2,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -6,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 * (1 - variable.particle_age / variable.particle_lifetime) + 0.02",
          "0.06 * (1 - variable.particle_age / variable.particle_lifetime) + 0.02"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "(1 - variable.particle_age / variable.particle_lifetime) * 0.7"
        ]
      }
    }
  }
}
