{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:sphere_flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/hex"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 24
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.radius",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.45)"
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22 * (1 - variable.particle_age / variable.particle_lifetime) + 0.05",
          "0.22 * (1 - variable.particle_age / variable.particle_lifetime) + 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.2)",
          "math.min(1, variable.color.g * 1.2)",
          "math.min(1, variable.color.b * 1.2)",
          "(1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
