{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 120
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.6
      },
      "minecraft:emitter_shape_disc": {
        "plane_normal": "y",
        "radius": 1.3,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.8, 1.4)"
      },
      "minecraft:particle_initial_speed": "math.random(3, 6)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.08",
          "0.45 * (1 - variable.particle_age / variable.particle_lifetime) + 0.1"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.2)",
          "math.min(1, variable.color.g * 1.2)",
          "math.min(1, variable.color.b * 1.2)",
          "(1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
