{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:emblem",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/emblem"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2.6
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          "(variable.particle_age / variable.particle_lifetime) * 0.8",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.4 + 0.3 * math.sin(variable.particle_age * 180)",
          "1.4 + 0.3 * math.sin(variable.particle_age * 180)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.2)",
          "math.min(1, variable.color.g * 1.2)",
          "math.min(1, variable.color.b * 1.2)",
          "math.clamp(math.min((variable.particle_age / variable.particle_lifetime) * 5, (1 - variable.particle_age / variable.particle_lifetime) * 2.5), 0, 1)"
        ]
      }
    }
  }
}
