{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(variable.beam.speed * 5, 4, 220)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.18, 0.32)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.beam.direction_x * variable.particle_random_1 * variable.beam.speed + (variable.particle_random_2 - 0.5) * 0.06 * variable.width",
          "variable.beam.direction_y * variable.particle_random_1 * variable.beam.speed + (variable.particle_random_3 - 0.5) * 0.06 * variable.width",
          "variable.beam.direction_z * variable.particle_random_1 * variable.beam.speed + (variable.particle_random_4 - 0.5) * 0.06 * variable.width"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.18 + variable.particle_random_2 * 0.08) * variable.width * (0.4 + 0.6 * (1 - variable.particle_age / variable.particle_lifetime))",
          "(0.18 + variable.particle_random_2 * 0.08) * variable.width * (0.4 + 0.6 * (1 - variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.3)",
          "math.min(1, variable.color.g * 1.3)",
          "math.min(1, variable.color.b * 1.3)",
          "(1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
