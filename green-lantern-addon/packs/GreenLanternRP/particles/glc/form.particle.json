{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:form",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.22, 0.36)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos((variable.particle_random_2 * 180 - 90)) * math.cos(variable.particle_random_1 * 360) * variable.radius * (1 - variable.particle_age / variable.particle_lifetime)",
          "math.sin((variable.particle_random_2 * 180 - 90)) * variable.radius * (1 - variable.particle_age / variable.particle_lifetime)",
          "math.cos((variable.particle_random_2 * 180 - 90)) * math.sin(variable.particle_random_1 * 360) * variable.radius * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.10 + 0.12 * (variable.particle_age / variable.particle_lifetime)",
          "0.10 + 0.12 * (variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.2)",
          "math.min(1, variable.color.g * 1.2)",
          "math.min(1, variable.color.b * 1.2)",
          "0.4 + 0.6 * (variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
