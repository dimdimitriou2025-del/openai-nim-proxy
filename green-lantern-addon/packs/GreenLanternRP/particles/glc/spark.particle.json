{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.15,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.55)"
      },
      "minecraft:particle_initial_speed": "math.random(3, 7)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -4,
          0
        ],
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - variable.particle_age / variable.particle_lifetime) + 0.03",
          "0.16 * (1 - variable.particle_age / variable.particle_lifetime) + 0.03"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.2)",
          "math.min(1, variable.color.g * 1.2)",
          "math.min(1, variable.color.b * 1.2)",
          "(1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
