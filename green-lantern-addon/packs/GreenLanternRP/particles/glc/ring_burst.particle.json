{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "glc:ring_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/glc/particle/glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 36
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "plane_normal": "y",
        "radius": 0.3,
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.8)"
      },
      "minecraft:particle_initial_speed": "math.random(5, 8)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * (1 - variable.particle_age / variable.particle_lifetime) + 0.04",
          "0.18 * (1 - variable.particle_age / variable.particle_lifetime) + 0.04"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.min(1, variable.color.r * 1.2)",
          "math.min(1, variable.color.g * 1.2)",
          "math.min(1, variable.color.b * 1.2)",
          "(1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
