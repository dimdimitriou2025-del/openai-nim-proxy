{
  "format_version": "1.8.0",
  "animations": {
    "animation.glc.construct.grow": {
      "loop": true,
      "bones": {
        "root": {
          "scale": "v.size * v.grow"
        }
      }
    },
    "animation.glc.construct.dissolve": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.4,
      "bones": {
        "root": {
          "scale": "v.size * math.max(0.0, 1.0 - q.anim_time * 2.8) * (1.0 + math.sin(q.anim_time * 2600.0) * 0.12)"
        }
      }
    },
    "animation.glc.construct.pitch": {
      "loop": true,
      "bones": {
        "pitch": {
          "rotation": [
            "q.property('glc:pitch')",
            0,
            0
          ]
        }
      }
    },
    "animation.glc.hammer.slam": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.6,
      "bones": {
        "swing": {
          "rotation": {
