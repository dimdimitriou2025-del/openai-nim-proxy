{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@minecraft/server": ["./node_modules/@minecraft/server"],
      "@minecraft/server-ui": ["./node_modules/@minecraft/server-ui"],
      "@minecraft/common": ["./node_modules/@minecraft/common"]
    }
  },
  "include": ["../../packs/GreenLanternBP/scripts/**/*.js", "./globals.d.ts"]
}
